# --- Seguridad -------------------------------------------------------------
# API keys de tus clientes: "clave:etiqueta" separadas por comas.
# Genera claves largas, p. ej.: node -e "console.log('sk_live_'+require('crypto').randomBytes(24).toString('hex'))"
# En producción la API rechaza solicitudes si esta variable está vacía.
API_KEYS=sk_live_cambia_esta_clave:cliente-principal

# Unidades por minuto por API key (cada endpoint consume 1–10 unidades).
RATE_LIMIT_PER_MINUTE=60

# Orígenes permitidos para llamar la API desde un navegador (CORS). Vacío = solo servidor a servidor.
CORS_ORIGINS=

# --- Demo pública (página principal con el mapa) ---------------------------
DEMO_ENABLED=true
DEMO_RATE_LIMIT_PER_MINUTE=20

# --- Proveedores de datos (todos gratuitos) --------------------------------
# Orden de proveedores de irradiancia. clear-sky siempre queda como último respaldo.
IRRADIANCE_PROVIDERS=pvgis-nsrdb,nasa-power,pvgis-era5,clear-sky
# Overpass y Nominatim piden identificar la app con un contacto.
UPSTREAM_USER_AGENT="TechoSolarAPI/1.0 (contacto: soporte@tu-empresa.ec)"
# Instancias propias para volumen alto (opcional).
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Opcional: Google Solar API (sin cobertura publicada para Ecuador; sí Perú, Colombia, México, Brasil).
# GOOGLE_SOLAR_API_KEY=

# --- Límites ---------------------------------------------------------------
MAX_PROSPECT_AREA_KM2=4
MAX_ROOF_AREA_M2=200000
MAX_PANELS=20000
LOG_REQUESTS=true
